{
  "name": "ai-chat-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --env-file=.env --import tsx --test tests/integration.ts",
    "test:admin": "node --env-file=.env --import tsx --test tests/admin-integration.ts",
    "test:images": "node --env-file=.env --import tsx --test tests/character-images-integration.ts",
    "test:models": "node --env-file=.env --import tsx --test tests/models-integration.ts",
    "admin:setup": "node --env-file=.env --import tsx scripts/admin.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "db:deploy": "prisma migrate deploy",
    "load:test": "k6 run scripts/load-test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.27",
    "openai": "^7.28.0",
    "prisma": "^6.16.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.4",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "deepmerge-ts": "^8.0.0"
  }
}
