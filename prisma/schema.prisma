generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  FROZEN
  DELETED
}

enum UserRole {
  USER
  ADMIN
}

enum CharacterStatus {
  DRAFT
  REVIEWING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  adminUsername String?      @unique
  passwordHash String
  nickname     String?
  status       UserStatus    @default(ACTIVE)
  role         UserRole      @default(USER)
  auditLogs    AdminAudit[]
  wallet       Wallet?
  characters   Character[]   @relation("CharacterOwner")
  sessions     ChatSession[]
  orders       Order[]
  authSessions AuthSession[]
  requests     ChatRequest[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
}

model AdminAudit {
  id String @id @default(cuid())
  actorId String
  action String
  entityId String
  detail Json
  createdAt DateTime @default(now())
  actor User @relation(fields: [actorId], references: [id])
  @@index([createdAt])
  @@index([entityId, createdAt])
}

model Wallet {
  id        String              @id @default(cuid())
  userId    String              @unique
  balance   Int                 @default(0)
  user      User                @relation(fields: [userId], references: [id])
  records   WalletTransaction[]
  updatedAt DateTime            @updatedAt
}

model WalletTransaction {
  id        String   @id @default(cuid())
  walletId  String
  amount    Int
  reason    String
  refType   String?
  refId     String?
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@unique([refType, refId])
}

model Character {
  id             String          @id @default(cuid())
  ownerId        String?
  name           String
  title          String
  avatarUrl      String?
  greeting       String
  systemPrompt   String
  tags           String[]
  pricePerMessage Int            @default(1)
  status         CharacterStatus @default(REVIEWING)
  popularity     Int             @default(0)
  owner          User?           @relation("CharacterOwner", fields: [ownerId], references: [id])
  sessions       ChatSession[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, popularity])
  @@index([ownerId, createdAt])
}

model ChatSession {
  id          String        @id @default(cuid())
  userId      String
  characterId String
  title       String?
  user        User          @relation(fields: [userId], references: [id])
  character   Character     @relation(fields: [characterId], references: [id])
  messages    ChatMessage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, updatedAt])
  @@unique([userId, characterId])
  @@index([characterId, updatedAt])
}

model AuthSession {
  tokenHash String @id
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model ChatRequest {
  id String @id
  userId String
  characterId String
  content String
  status String @default("PENDING")
  reply String?
  feature String @default("CHAT")
  result Json?
  coins Int
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@index([status, createdAt])
}

model ChatMessage {
  id           String      @id @default(cuid())
  sessionId    String
  role         MessageRole
  content      String
  promptTokens Int         @default(0)
  outputTokens Int         @default(0)
  costCoins    Int         @default(0)
  latencyMs    Int?
  model        String?
  attachments  Json          @default("[]")
  session      ChatSession @relation(fields: [sessionId], references: [id])
  createdAt    DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model AIConfiguration {
  id String @id @default("main")
  version Int @default(1)
  config Json
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id String @id
  userId String
  requestId String
  mimeType String
  size Int
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([requestId])
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  provider      String
  providerRef   String?     @unique
  amountCents   Int
  coins         Int
  status        OrderStatus @default(PENDING)
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())
  paidAt        DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
